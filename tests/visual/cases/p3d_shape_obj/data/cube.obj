# a cube with two materials, normals per face, and a pyramid on top without normals
mtllib cube.mtl
v -1 -1 -1
v 1 -1 -1
v 1 1 -1
v -1 1 -1
v -1 -1 1
v 1 -1 1
v 1 1 1
v -1 1 1
v 0 -2.2 0
vn 0 0 -1
vn 0 0 1
vn -1 0 0
vn 1 0 0
vn 0 1 0
usemtl red
f 1//1 2//1 3//1 4//1
f 5//2 8//2 7//2 6//2
usemtl blue
f 1//3 4//3 8//3 5//3
f 2//4 6//4 7//4 3//4
f 4//5 3//5 7//5 8//5
usemtl yellow
f 1 5 9
f 5 6 9
f 6 2 9
f 2 1 9
