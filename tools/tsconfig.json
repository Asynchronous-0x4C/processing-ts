{
  // Type-check only (tools run directly with Node's built-in type stripping; Node >= 22.18).
  // npx tsc -p tools
  "compilerOptions": {
    "target": "ES2024",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2024", "DOM", "DOM.Iterable"],
    "types": ["node"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true
  },
  "include": ["./**/*.ts"],
  // The harness runs in the browser through Vite and imports src/lib (checked by the root tsconfig).
  "exclude": ["./vt/harness"]
}
