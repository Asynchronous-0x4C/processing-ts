{
  // Type-check only. The ahead-of-time tools (CLI, Vite plugin) run in Node (type stripping in the repository).
  "compilerOptions": {
    "target": "ES2024",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2024"],
    "types": ["node"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true
  },
  "include": ["./*.ts"],
  "exclude": ["./client.d.ts"]
}
