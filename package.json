{
  "name": "@async0x4c/processing-ts",
  "private": false,
  "version": "0.1.0",
  "description": "A Processing to JavaScript transpiler for web applications.",
  "main": "dist/index.js",
  "types": "dist/types/index.d.ts",
  "type": "module",
  "author": {
    "name": "async0x4c"
  },
  "homepage": "https://github.com/Asynchronous-0x4C/processing-ts",
  "bugs": {
    "url": "https://github.com/Asynchronous-0x4C/processing-ts/issues"
  },
  "license": "MIT",
  "keywords": [
    "transpiler",
    "processing"
  ],
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "README.md",
    "THIRD_PARTY_NOTICES.md"
  ],
  "scripts": {
    "dev": "vite",
    "devh": "vite --host",
    "build": "vite build && tsc",
    "preview": "vite preview",
    "test:visual": "node tools/vt/cli.ts run",
    "test:visual:ref": "node tools/vt/cli.ts ref",
    "vt": "node tools/vt/cli.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit --emitDeclarationOnly false && tsc -p src/compiler && tsc -p src/runtime && tsc -p tools && tsc -p tests",
    "test": "vitest run",
    "bench": "node tools/bench/cli.ts parse compile transpile",
    "size": "node tools/bench/cli.ts size",
    "gen:grammar": "lezer-generator --typeScript src/compiler/grammar/processing.grammar -o src/compiler/grammar/parser.ts",
    "test:grammar": "node tools/grammar/compare.ts",
    "test:check": "node tools/check/compare.ts",
    "test:lang": "node tools/lang/cli.ts",
    "gen:manifest": "node tools/manifest/generate.ts",
    "coverage": "node tools/manifest/coverage.ts"
  },
  "devDependencies": {
    "@lezer/generator": "^1.8.1",
    "@types/node": "^24.0.3",
    "@types/pngjs": "^6.0.5",
    "antlr4": "^4.13.2",
    "esbuild": "^0.25.12",
    "pixelmatch": "^7.2.0",
    "playwright-core": "^1.63.0",
    "pngjs": "^7.0.0",
    "typescript": "~5.7.2",
    "vite": "^6.2.0",
    "vite-plugin-externalize-deps": "^0.9.0",
    "vitest": "^3.2.7"
  },
  "dependencies": {
    "@lezer/common": "^1.5.3",
    "@lezer/lr": "^1.4.10",
    "pixi.js": "^8.9.1"
  },
  "engines": {
    "node": ">=22.18"
  }
}
